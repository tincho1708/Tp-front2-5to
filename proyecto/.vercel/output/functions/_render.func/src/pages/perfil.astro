---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout titulo="Mi Perfil">
  <Navbar />
  <main class="con-nav">
    <section class="cabecera-pagina">
      <div class="contenedor">
        <div class="perfil-cabecera">
          <div class="avatar-wrapper">
            <div class="avatar">
              <span class="avatar-iniciales" id="avatar-iniciales">??</span>
            </div>
          </div>
          <div class="info-usuario">
            <h1 class="nombre-usuario" id="nombre-display">Cargando...</h1>
            <p class="usuario-handle" id="usuario-handle">@usuario</p>
            <p class="usuario-desde" id="usuario-desde"></p>
            <div class="stats-perfil">
              <div class="stat-mini">
                <span class="stat-mini-num verde" id="stat-autos">-</span>
                <span class="stat-mini-label">Autos</span>
              </div>
              <div class="stat-mini">
                <span class="stat-mini-num rojo" id="stat-favs">-</span>
                <span class="stat-mini-label">Favoritos</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="seccion-perfil">
      <div class="contenedor layout-perfil">
        <div class="columna-form">
          <div class="card-seccion">
            <h2 class="titulo-seccion-card">Información personal</h2>
            <div id="ok-info" class="mensaje-ok oculto"></div>
            <div id="error-info" class="mensaje-error oculto"></div>
            <div class="campos-perfil">
              <div class="fila-campos">
                <div class="campo-form">
                  <label class="etiqueta-campo">Nombre</label>
                  <input type="text" class="input-form" id="input-nombre" placeholder="Tu nombre" />
                </div>
                <div class="campo-form">
                  <label class="etiqueta-campo">Apellido</label>
                  <input type="text" class="input-form" id="input-apellido" placeholder="Tu apellido" />
                </div>
              </div>
              <div class="campo-form">
                <label class="etiqueta-campo">Nombre de usuario</label>
                <div class="input-prefijo-wrapper">
                  <span class="input-prefijo">@</span>
                  <input type="text" class="input-form con-prefijo" id="input-usuario" placeholder="usuario" />
                </div>
              </div>
              <div class="campo-form">
                <label class="etiqueta-campo">Email</label>
                <input type="email" class="input-form" id="input-email" disabled />
              </div>
              <div class="campo-form">
                <label class="etiqueta-campo">Bio</label>
                <textarea class="input-form textarea-form" id="input-bio" placeholder="Contá algo sobre vos..."></textarea>
              </div>
              <button class="boton-guardar" id="btn-guardar-info">Guardar cambios</button>
            </div>
          </div>

          <div class="card-seccion">
            <h2 class="titulo-seccion-card">Cambiar contraseña</h2>
            <div id="ok-pass" class="mensaje-ok oculto"></div>
            <div id="error-pass" class="mensaje-error oculto"></div>
            <div class="campos-perfil">
              <div class="fila-campos">
                <div class="campo-form">
                  <label class="etiqueta-campo">Nueva contraseña</label>
                  <input type="password" class="input-form" id="input-pass-nueva" placeholder="Mínimo 8 caracteres" />
                </div>
                <div class="campo-form">
                  <label class="etiqueta-campo">Repetir nueva</label>
                  <input type="password" class="input-form" id="input-pass-rep" placeholder="••••••••" />
                </div>
              </div>
              <button class="boton-guardar" id="btn-cambiar-pass">Actualizar contraseña</button>
            </div>
          </div>
        </div>

        <div class="columna-lateral">
          <div class="card-seccion card-peligro">
            <h2 class="titulo-seccion-card rojo">Zona de peligro</h2>
            <p class="texto-peligro">Estas acciones no se pueden deshacer. Pensalo bien.</p>
            <div class="acciones-peligro">
              <button class="btn-peligro btn-limpiar" id="btn-limpiar">Limpiar colección</button>
              <button class="btn-peligro btn-eliminar" id="btn-eliminar-cuenta">Eliminar cuenta</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cabecera-pagina { padding: 3rem 0 2.5rem; border-bottom: 1px solid var(--borde); }

  .perfil-cabecera { display: flex; gap: 2rem; align-items: flex-start; flex-wrap: wrap; }

  .avatar-wrapper { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }

  .avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(57,255,20,0.3), rgba(0,207,255,0.3));
    border: 2px solid rgba(57,255,20,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-iniciales { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: #fff; letter-spacing: 2px; }

  .info-usuario { flex: 1; }

  .nombre-usuario { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 1.5px; color: #fff; margin-bottom: 0.2rem; }
  .usuario-handle { font-size: 0.8rem; color: var(--verde); margin-bottom: 0.3rem; opacity: 0.8; }
  .usuario-desde { font-size: 0.7rem; color: #555; margin-bottom: 1rem; }

  .stats-perfil { display: flex; gap: 1.5rem; }
  .stat-mini { display: flex; flex-direction: column; gap: 2px; }

  .stat-mini-num { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; color: #fff; letter-spacing: 1px; line-height: 1; }
  .stat-mini-num.verde { color: var(--verde); }
  .stat-mini-num.rojo { color: var(--rojo); }

  .stat-mini-label { font-size: 0.6rem; color: #444; text-transform: uppercase; letter-spacing: 1px; }

  .seccion-perfil { padding: 2.5rem 0 5rem; }

  .layout-perfil { display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start; }

  .columna-form { display: flex; flex-direction: column; gap: 1.5rem; }
  .columna-lateral { display: flex; flex-direction: column; gap: 1.5rem; }

  .card-seccion { background: var(--fondo-card); border: 1px solid var(--borde); border-radius: 10px; padding: 1.5rem; }

  .titulo-seccion-card { font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 2px; color: #fff; margin-bottom: 1.2rem; }
  .titulo-seccion-card.rojo { color: var(--rojo); }

  .campos-perfil { display: flex; flex-direction: column; gap: 1rem; }
  .fila-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .campo-form { display: flex; flex-direction: column; gap: 0.4rem; }

  .etiqueta-campo { font-size: 0.65rem; letter-spacing: 1.5px; text-transform: uppercase; color: #666; }

  .input-form {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--borde);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-radius: 6px;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }

  .input-form:focus { border-color: rgba(57,255,20,0.4); }
  .input-form::placeholder { color: #333; }
  .input-form:disabled { opacity: 0.4; cursor: not-allowed; }

  .textarea-form { resize: vertical; min-height: 80px; line-height: 1.6; }

  .input-prefijo-wrapper { position: relative; display: flex; align-items: center; }
  .input-prefijo { position: absolute; left: 0.9rem; color: #555; font-size: 0.85rem; pointer-events: none; }
  .con-prefijo { padding-left: 1.7rem; }

  .mensaje-ok {
    background: rgba(57,255,20,0.1);
    border: 1px solid rgba(57,255,20,0.3);
    color: var(--verde);
    font-size: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }

  .mensaje-error {
    background: rgba(255,68,68,0.1);
    border: 1px solid rgba(255,68,68,0.3);
    color: var(--rojo);
    font-size: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }

  .boton-guardar {
    background: var(--verde);
    border: none;
    color: #050505;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 2px;
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  .boton-guardar:hover { opacity: 0.85; }
  .boton-guardar:disabled { opacity: 0.5; cursor: not-allowed; }

  .card-peligro { border-color: rgba(255,68,68,0.2); }
  .texto-peligro { font-size: 0.75rem; color: #666; margin-bottom: 1rem; line-height: 1.6; }
  .acciones-peligro { display: flex; flex-direction: column; gap: 0.5rem; }

  .btn-peligro {
    background: none;
    border: 1px solid rgba(255,68,68,0.25);
    color: var(--rojo);
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 1.5px;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
  }

  .btn-peligro:hover { background: rgba(255,68,68,0.1); border-color: rgba(255,68,68,0.4); }
  .btn-eliminar { color: #ff2222; border-color: rgba(255,34,34,0.3); }

  .oculto { display: none !important; }

  @media (max-width: 900px) { .layout-perfil { grid-template-columns: 1fr; } }
  @media (max-width: 500px) { .fila-campos { grid-template-columns: 1fr; } }
</style>

<script>
  import { supabase } from '../lib/supabase';

  async function cargarPerfil() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { window.location.href = '/login'; return; }

    const meta = user.user_metadata || {};
    const nombre = meta.nombre || '';
    const apellido = meta.apellido || '';
    const usuario = meta.usuario || '';
    const bio = meta.bio || '';
    const nombreCompleto = [nombre, apellido].filter(Boolean).join(' ') || user.email!.split('@')[0];

    const iniciales = nombreCompleto.slice(0, 2).toUpperCase();
    document.getElementById('avatar-iniciales')!.textContent = iniciales;
    document.getElementById('nombre-display')!.textContent = nombreCompleto;
    document.getElementById('usuario-handle')!.textContent = `@${usuario || nombreCompleto.toLowerCase().replace(/\s+/g, '')}`;
    document.getElementById('usuario-desde')!.textContent = `Miembro desde ${new Date(user.created_at).toLocaleDateString('es-AR', { month: 'long', year: 'numeric' })}`;

    (document.getElementById('input-nombre') as HTMLInputElement).value = nombre;
    (document.getElementById('input-apellido') as HTMLInputElement).value = apellido;
    (document.getElementById('input-usuario') as HTMLInputElement).value = usuario;
    (document.getElementById('input-email') as HTMLInputElement).value = user.email!;
    (document.getElementById('input-bio') as HTMLTextAreaElement).value = bio;

    const { data: autosData } = await supabase.from('autos').select('id, favorito');
    const autos = autosData || [];
    document.getElementById('stat-autos')!.textContent = String(autos.length);
    document.getElementById('stat-favs')!.textContent = String(autos.filter((a: any) => a.favorito).length);
  }

  document.getElementById('btn-guardar-info')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-guardar-info') as HTMLButtonElement;
    const okEl = document.getElementById('ok-info')!;
    const errEl = document.getElementById('error-info')!;
    okEl.classList.add('oculto');
    errEl.classList.add('oculto');

    const nombre = (document.getElementById('input-nombre') as HTMLInputElement).value.trim();
    const apellido = (document.getElementById('input-apellido') as HTMLInputElement).value.trim();
    const usuario = (document.getElementById('input-usuario') as HTMLInputElement).value.trim();
    const bio = (document.getElementById('input-bio') as HTMLTextAreaElement).value.trim();

    btn.disabled = true;
    btn.textContent = 'Guardando...';

    const { error } = await supabase.auth.updateUser({
      data: { nombre, apellido, usuario, bio },
    });

    if (error) {
      errEl.textContent = 'Error al guardar los cambios.';
      errEl.classList.remove('oculto');
    } else {
      okEl.textContent = 'Cambios guardados correctamente.';
      okEl.classList.remove('oculto');
      const nombreCompleto = [nombre, apellido].filter(Boolean).join(' ') || usuario;
      document.getElementById('nombre-display')!.textContent = nombreCompleto;
      document.getElementById('usuario-handle')!.textContent = `@${usuario}`;
      document.getElementById('avatar-iniciales')!.textContent = nombreCompleto.slice(0, 2).toUpperCase();
    }

    btn.disabled = false;
    btn.textContent = 'Guardar cambios';
  });

  document.getElementById('btn-cambiar-pass')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-cambiar-pass') as HTMLButtonElement;
    const okEl = document.getElementById('ok-pass')!;
    const errEl = document.getElementById('error-pass')!;
    okEl.classList.add('oculto');
    errEl.classList.add('oculto');

    const nueva = (document.getElementById('input-pass-nueva') as HTMLInputElement).value;
    const rep = (document.getElementById('input-pass-rep') as HTMLInputElement).value;

    if (nueva !== rep) { errEl.textContent = 'Las contraseñas no coinciden.'; errEl.classList.remove('oculto'); return; }
    if (nueva.length < 8) { errEl.textContent = 'La contraseña debe tener al menos 8 caracteres.'; errEl.classList.remove('oculto'); return; }

    btn.disabled = true;
    btn.textContent = 'Actualizando...';

    const { error } = await supabase.auth.updateUser({ password: nueva });

    if (error) {
      errEl.textContent = 'Error al actualizar la contraseña.';
      errEl.classList.remove('oculto');
    } else {
      okEl.textContent = 'Contraseña actualizada correctamente.';
      okEl.classList.remove('oculto');
      (document.getElementById('input-pass-nueva') as HTMLInputElement).value = '';
      (document.getElementById('input-pass-rep') as HTMLInputElement).value = '';
    }

    btn.disabled = false;
    btn.textContent = 'Actualizar contraseña';
  });

  document.getElementById('btn-limpiar')?.addEventListener('click', async () => {
    if (!confirm('¿Eliminar TODOS tus autos? Esta acción no se puede deshacer.')) return;
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    await supabase.from('autos').delete().eq('user_id', user.id);
    document.getElementById('stat-autos')!.textContent = '0';
    document.getElementById('stat-favs')!.textContent = '0';
    alert('Colección eliminada.');
  });

  document.getElementById('btn-eliminar-cuenta')?.addEventListener('click', async () => {
    if (!confirm('¿Eliminar tu cuenta definitivamente? Perderás todos tus datos.')) return;
    alert('Para eliminar tu cuenta contactá al administrador.');
  });

  cargarPerfil();
</script>
