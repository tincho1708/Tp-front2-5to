---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout titulo="Mi Colección">
  <Navbar />
  <main class="con-nav">
    <section class="cabecera-pagina">
      <div class="contenedor">
        <h1 class="titulo-pagina">Mi <span class="titulo-verde">Garage</span></h1>
        <p class="subtitulo-pagina">Todo tu registro en un solo lugar</p>
      </div>
    </section>

    <section class="seccion-stats">
      <div class="contenedor">
        <div class="grilla-stats">
          <div class="stat-card">
            <span class="stat-numero verde">8</span>
            <span class="stat-label">Autos en total</span>
          </div>
          <div class="stat-card">
            <span class="stat-numero rojo">2</span>
            <span class="stat-label">Favoritos</span>
          </div>
          <div class="stat-card">
            <span class="stat-numero azul">3</span>
            <span class="stat-label">JDM</span>
          </div>
          <div class="stat-card">
            <span class="stat-numero naranja">2</span>
            <span class="stat-label">Rally</span>
          </div>
        </div>
      </div>
    </section>

    <section class="seccion-actividad">
      <div class="contenedor">
        <div class="titulo-col-wrapper">
          <h2 class="titulo-col">🚗 Últimos autos agregados</h2>
          <a href="/autos" class="link-ver-todos">Ver todos →</a>
        </div>
        <div class="lista-recientes">
          {[
            { modelo: 'Skyline R34 GT-R', marca: 'Nissan', color: '#00cfff', fav: true },
            { modelo: 'Supra MK4', marca: 'Toyota', color: '#ff6b35', fav: false },
            { modelo: 'RX-7 FD3S', marca: 'Mazda', color: '#ff4444', fav: false },
            { modelo: 'Impreza WRX STI', marca: 'Subaru', color: '#4488ff', fav: true },
            { modelo: 'Lancer Evo IX', marca: 'Mitsubishi', color: '#39ff14', fav: false },
            { modelo: 'Civic Type R EK9', marca: 'Honda', color: '#fff', fav: false },
            { modelo: 'M3 E46', marca: 'BMW', color: '#888', fav: false },
            { modelo: 'Mustang GT500', marca: 'Ford', color: '#cc3300', fav: false },
          ].map(item => (
            <div class="item-reciente">
              <div class="item-info">
                <span class="punto-color" style={`background: ${item.color}`}></span>
                <span class="item-titulo">{item.modelo}</span>
              </div>
              <span class="item-marca">{item.marca} {item.fav ? '❤' : ''}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="seccion-accesos">
      <div class="contenedor">
        <div class="grilla-accesos">
          <a href="/autos" class="acceso-rapido">
            <span class="acceso-icono">🚗</span>
            <div>
              <p class="acceso-titulo">Mis Autos</p>
              <p class="acceso-sub">8 autos en el garage</p>
            </div>
            <span class="acceso-flecha">→</span>
          </a>
          <a href="/perfil" class="acceso-rapido">
            <span class="acceso-icono">👤</span>
            <div>
              <p class="acceso-titulo">Mi Perfil</p>
              <p class="acceso-sub">Editar cuenta</p>
            </div>
            <span class="acceso-flecha">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cabecera-pagina {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--borde);
  }

  .subtitulo-pagina {
    color: var(--texto-gris);
    font-size: 0.75rem;
    margin-top: 0.4rem;
    letter-spacing: 1px;
  }

  .seccion-stats { padding: 2.5rem 0; border-bottom: 1px solid var(--borde); }

  .grilla-stats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
  }

  .stat-card {
    background: var(--fondo-card);
    border: 1px solid var(--borde);
    border-radius: 8px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .stat-numero {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem;
    letter-spacing: 2px;
    color: #fff;
    line-height: 1;
  }

  .stat-numero.verde { color: var(--verde); }
  .stat-numero.azul { color: #00cfff; }
  .stat-numero.naranja { color: #ff6b35; }
  .stat-numero.rojo { color: var(--rojo); }

  .stat-label {
    font-size: 0.65rem;
    color: #555;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .seccion-actividad { padding: 2.5rem 0; border-bottom: 1px solid var(--borde); }

  .titulo-col-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .titulo-col {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 2px;
    color: #fff;
  }

  .link-ver-todos {
    font-size: 0.7rem;
    color: var(--verde);
    text-decoration: none;
    letter-spacing: 1px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .link-ver-todos:hover { opacity: 1; }

  .lista-recientes { display: flex; flex-direction: column; }

  .item-reciente {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--borde);
  }

  .item-reciente:last-child { border-bottom: none; }

  .item-info { display: flex; align-items: center; gap: 0.75rem; }

  .punto-color {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .item-titulo { font-size: 0.85rem; color: #ccc; }
  .item-marca { font-size: 0.7rem; color: #555; font-family: 'Space Mono', monospace; }

  .seccion-accesos { padding: 2.5rem 0 5rem; }

  .grilla-accesos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .acceso-rapido {
    background: var(--fondo-card);
    border: 1px solid var(--borde);
    border-radius: 8px;
    padding: 1.2rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .acceso-rapido:hover {
    border-color: rgba(57,255,20,0.25);
    transform: translateY(-2px);
  }

  .acceso-icono { font-size: 1.5rem; }

  .acceso-titulo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 1.5px;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .acceso-sub { font-size: 0.7rem; color: #555; }

  .acceso-flecha {
    margin-left: auto;
    color: var(--verde);
    font-size: 1.1rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .acceso-rapido:hover .acceso-flecha { opacity: 1; }
</style>