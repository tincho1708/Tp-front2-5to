---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout titulo="Registrarse">
  <Navbar />
  <main class="pagina-auth con-nav">
    <div class="contenedor-auth">
      <div class="card-auth">
        <div class="auth-cabecera">
          <a href="/" class="logo-auth">⚡ GRID<span class="verde">VAULT</span></a>
          <h1 class="titulo-auth">Crear cuenta</h1>
          <p class="subtitulo-auth">Gratis, sin drama</p>
        </div>

        <div class="formulario-auth">
          <div class="fila-campos">
            <div class="campo-form">
              <label class="etiqueta-campo">Nombre</label>
              <input type="text" class="input-form" placeholder="Tu nombre" />
            </div>
            <div class="campo-form">
              <label class="etiqueta-campo">Usuario</label>
              <input type="text" class="input-form" placeholder="@usuario" id="campo-usuario" />
            </div>
          </div>

          <div class="campo-form">
            <label class="etiqueta-campo">Email</label>
            <input type="email" class="input-form" placeholder="vos@ejemplo.com" />
          </div>

          <div class="campo-form">
            <label class="etiqueta-campo">Contraseña</label>
            <input type="password" class="input-form" placeholder="Mínimo 8 caracteres" id="campo-pass" />
            <div class="barra-fortaleza" id="barra-fortaleza">
              <div class="segmento-fortaleza" data-nivel="1"></div>
              <div class="segmento-fortaleza" data-nivel="2"></div>
              <div class="segmento-fortaleza" data-nivel="3"></div>
              <div class="segmento-fortaleza" data-nivel="4"></div>
            </div>
          </div>

          <div class="campo-form">
            <label class="etiqueta-campo">Repetir contraseña</label>
            <input type="password" class="input-form" placeholder="••••••••" />
          </div>

          <label class="checkbox-wrapper">
            <input type="checkbox" class="checkbox-real" />
            <span class="checkbox-custom"></span>
            <span class="checkbox-label">Acepto los <a href="#" class="link-terminos">términos y condiciones</a></span>
          </label>

          <button class="boton-submit">Crear cuenta</button>

        </div>

        <p class="link-alternativo">
          ¿Ya tenés cuenta? <a href="/login">Iniciar sesión</a>
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .pagina-auth {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .contenedor-auth { width: 100%; max-width: 440px; }

  .card-auth {
    background: var(--fondo-card);
    border: 1px solid var(--borde);
    border-radius: 12px;
    padding: 2.5rem;
  }

  .auth-cabecera {
    text-align: center;
    margin-bottom: 2rem;
  }

  .logo-auth {
    display: inline-block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 2px;
    color: #fff;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .verde { color: var(--verde); }

  .titulo-auth {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem;
    letter-spacing: 1.5px;
    color: #fff;
    margin-bottom: 0.3rem;
  }

  .subtitulo-auth { font-size: 0.8rem; color: var(--texto-gris); }

  .formulario-auth { display: flex; flex-direction: column; gap: 1rem; }

  .fila-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  .campo-form { display: flex; flex-direction: column; gap: 0.4rem; }

  .etiqueta-campo {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #666;
  }

  .input-form {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--borde);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    padding: 0.6rem 0.9rem;
    border-radius: 6px;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }

  .input-form:focus { border-color: rgba(57,255,20,0.4); }
  .input-form::placeholder { color: #333; }

  .barra-fortaleza {
    display: flex;
    gap: 4px;
    margin-top: 0.4rem;
  }

  .segmento-fortaleza {
    flex: 1;
    height: 3px;
    background: #222;
    border-radius: 2px;
    transition: background 0.2s;
  }

  .segmento-fortaleza.activo[data-nivel="1"] { background: var(--rojo); }
  .segmento-fortaleza.activo[data-nivel="2"] { background: #ff6b35; }
  .segmento-fortaleza.activo[data-nivel="3"] { background: #ffd700; }
  .segmento-fortaleza.activo[data-nivel="4"] { background: var(--verde); }

  .checkbox-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    cursor: pointer;
  }

  .checkbox-real { display: none; }

  .checkbox-custom {
    width: 14px;
    height: 14px;
    border: 1px solid #444;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
    transition: all 0.15s;
  }

  .checkbox-real:checked + .checkbox-custom {
    background: var(--verde);
    border-color: var(--verde);
  }

  .checkbox-real:checked + .checkbox-custom::after {
    content: '✓';
    font-size: 0.65rem;
    color: #050505;
    font-weight: bold;
  }

  .checkbox-label { font-size: 0.7rem; color: #666; line-height: 1.5; }

  .link-terminos { color: var(--verde); text-decoration: none; opacity: 0.8; }
  .link-terminos:hover { opacity: 1; }

  .boton-submit {
    background: var(--verde);
    border: none;
    color: #050505;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 2px;
    padding: 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    width: 100%;
    transition: opacity 0.2s;
    margin-top: 0.25rem;
  }

  .boton-submit:hover { opacity: 0.85; }

  .link-alternativo {
    text-align: center;
    font-size: 0.75rem;
    color: #555;
    margin-top: 1.5rem;
  }

  .link-alternativo a {
    color: var(--verde);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .link-alternativo a:hover { opacity: 1; }
</style>

<script>
  const campoPass = document.getElementById('campo-pass') as HTMLInputElement;
  const segmentos = document.querySelectorAll('.segmento-fortaleza');

  campoPass?.addEventListener('input', () => {
    const val = campoPass.value;
    let nivel = 0;
    if (val.length >= 4) nivel = 1;
    if (val.length >= 8) nivel = 2;
    if (val.length >= 8 && /[A-Z]/.test(val) && /[0-9]/.test(val)) nivel = 3;
    if (val.length >= 12 && /[A-Z]/.test(val) && /[0-9]/.test(val) && /[^a-zA-Z0-9]/.test(val)) nivel = 4;

    segmentos.forEach((seg, i) => {
      seg.classList.toggle('activo', i < nivel);
    });
  });
</script>