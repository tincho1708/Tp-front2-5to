---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const autos = [
  { id: 1, marca: 'Nissan', modelo: 'Skyline R34 GT-R', anio: 1999, estilo: 'JDM', motor: 'RB26DETT', color: '#00cfff', favorito: true },
  { id: 2, marca: 'Toyota', modelo: 'Supra MK4', anio: 1993, estilo: 'JDM', motor: '2JZ-GTE', color: '#ff6b35', favorito: false },
  { id: 3, marca: 'Mazda', modelo: 'RX-7 FD3S', anio: 1992, estilo: 'JDM', motor: '13B Rotary', color: '#ff4444', favorito: false },
  { id: 4, marca: 'Mitsubishi', modelo: 'Lancer Evo IX', anio: 2005, estilo: 'Rally', motor: '4G63T', color: '#39ff14', favorito: false },
  { id: 5, marca: 'Subaru', modelo: 'Impreza WRX STI', anio: 2004, estilo: 'Rally', motor: 'EJ207', color: '#4488ff', favorito: true },
  { id: 6, marca: 'Honda', modelo: 'Civic Type R EK9', anio: 1997, estilo: 'JDM', motor: 'B16B', color: '#fff', favorito: false },
  { id: 7, marca: 'BMW', modelo: 'M3 E46', anio: 2001, estilo: 'Europeo', motor: 'S54B32', color: '#888', favorito: false },
  { id: 8, marca: 'Ford', modelo: 'Mustang GT500', anio: 1967, estilo: 'Muscle', motor: '427 V8', color: '#cc3300', favorito: false },
];
---

<Layout titulo="Autos">
  <Navbar />
  <main class="con-nav">
    <section class="cabecera-pagina">
      <div class="contenedor">
        <div>
          <h1 class="titulo-pagina">Mi <span class="titulo-verde">Garage</span></h1>
          <p class="subtitulo-pagina">{autos.length} autos registrados</p>
        </div>
        <button class="boton-agregar" id="btn-abrir-modal">+ Agregar auto</button>
      </div>
    </section>

    <section class="seccion-filtros">
      <div class="contenedor">
        <div class="barra-filtros">
          <div class="grupo-filtros">
            <button class="chip activo" data-filtro="todos">Todos</button>
            <button class="chip" data-filtro="JDM">JDM</button>
            <button class="chip" data-filtro="Rally">Rally</button>
            <button class="chip" data-filtro="Europeo">Europeos</button>
            <button class="chip" data-filtro="Muscle">Muscle</button>
          </div>
          <div class="buscador-wrapper">
            <span class="icono-buscar">⌕</span>
            <input type="text" class="input-buscar" id="buscador" placeholder="Buscar auto..." />
          </div>
        </div>
      </div>
    </section>

    <section class="seccion-grilla">
      <div class="contenedor">
        <div class="grilla-autos" id="grilla-autos">
          {autos.map(auto => (
            <article class="card-auto" data-estilo={auto.estilo} data-nombre={(auto.marca + ' ' + auto.modelo).toLowerCase()}>
              <div class="barra-top" style={`background: ${auto.color}`}></div>
              <div class="card-contenido">
                <div class="card-cabecera">
                  <div class="badges-auto">
                    <span class="badge-estilo">{auto.estilo}</span>
                    {auto.favorito && <span class="badge-fav">❤ FAV</span>}
                  </div>
                  <button class="btn-menu-card">···</button>
                </div>
                <div class="card-nombre">
                  <p class="card-marca">{auto.marca}</p>
                  <h3 class="card-modelo">{auto.modelo}</h3>
                </div>
                <div class="card-specs">
                  <div class="spec-fila">
                    <span class="spec-key">Año</span>
                    <span class="spec-val">{auto.anio}</span>
                  </div>
                  <div class="spec-fila">
                    <span class="spec-key">Motor</span>
                    <span class="spec-val">{auto.motor}</span>
                  </div>
                  <div class="spec-fila">
                    <span class="spec-key">Color</span>
                    <span class="muestra-color" style={`background: ${auto.color}`}></span>
                  </div>
                </div>
                <div class="card-acciones">
                  <button class="btn-ver">Ver detalle</button>
                  <button class="btn-fav">{auto.favorito ? '❤' : '♡'}</button>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="sin-resultados oculto" id="sin-resultados">No se encontraron autos.</p>
      </div>
    </section>
  </main>

  <div class="overlay-modal oculto" id="overlay-modal">
    <div class="modal">
      <div class="modal-cabecera">
        <h2 class="modal-titulo">Agregar Auto</h2>
        <button class="modal-cerrar" id="btn-cerrar-modal">✕</button>
      </div>
      <div class="modal-cuerpo">
        <div class="fila-campos">
          <div class="campo-form">
            <label class="etiqueta-campo">Marca</label>
            <input type="text" class="input-form" placeholder="ej. Nissan" />
          </div>
          <div class="campo-form">
            <label class="etiqueta-campo">Modelo</label>
            <input type="text" class="input-form" placeholder="ej. Skyline R34" />
          </div>
        </div>
        <div class="fila-campos">
          <div class="campo-form">
            <label class="etiqueta-campo">Año</label>
            <input type="number" class="input-form" placeholder="1999" />
          </div>
          <div class="campo-form">
            <label class="etiqueta-campo">Estilo</label>
            <select class="input-form select-form">
              <option value="">Seleccionar</option>
              <option>JDM</option>
              <option>Rally</option>
              <option>Europeo</option>
              <option>Muscle</option>
              <option>Otro</option>
            </select>
          </div>
        </div>
        <div class="fila-campos">
          <div class="campo-form">
            <label class="etiqueta-campo">Motor</label>
            <input type="text" class="input-form" placeholder="ej. RB26DETT" />
          </div>
          <div class="campo-form">
            <label class="etiqueta-campo">Color</label>
            <input type="color" class="input-form input-color" value="#39ff14" />
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancelar" id="btn-cancelar">Cancelar</button>
        <button class="btn-guardar">Guardar</button>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .cabecera-pagina {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--borde);
  }

  .cabecera-pagina .contenedor {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .subtitulo-pagina {
    color: var(--texto-gris);
    font-size: 0.75rem;
    margin-top: 0.4rem;
    letter-spacing: 1px;
  }

  .boton-agregar {
    background: var(--verde);
    color: #050505;
    border: none;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 2px;
    padding: 0.6rem 1.4rem;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .boton-agregar:hover { opacity: 0.85; }

  .seccion-filtros {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--borde);
  }

  .barra-filtros {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .grupo-filtros { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .chip {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--borde);
    color: var(--texto-gris);
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 1px;
    padding: 0.3rem 0.8rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .chip.activo, .chip:hover {
    background: rgba(57,255,20,0.1);
    border-color: rgba(57,255,20,0.3);
    color: var(--verde);
  }

  .buscador-wrapper { position: relative; display: flex; align-items: center; }

  .icono-buscar {
    position: absolute;
    left: 0.7rem;
    color: var(--texto-gris);
    font-size: 1.1rem;
    pointer-events: none;
  }

  .input-buscar {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--borde);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    padding: 0.4rem 0.8rem 0.4rem 2.2rem;
    border-radius: 3px;
    width: 220px;
    outline: none;
    transition: border-color 0.2s;
  }

  .input-buscar::placeholder { color: #444; }
  .input-buscar:focus { border-color: rgba(57,255,20,0.3); }

  .seccion-grilla { padding: 2.5rem 0 4rem; }

  .grilla-autos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .card-auto {
    background: var(--fondo-card);
    border: 1px solid var(--borde);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }

  .card-auto:hover {
    border-color: rgba(255,255,255,0.15);
    transform: translateY(-3px);
  }

  .barra-top { height: 3px; }

  .card-contenido {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .card-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .badges-auto { display: flex; gap: 0.4rem; align-items: center; }

  .badge-estilo {
    font-size: 0.6rem;
    font-family: 'Space Mono', monospace;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #666;
    background: rgba(255,255,255,0.05);
    border-radius: 2px;
    padding: 2px 6px;
  }

  .badge-fav {
    font-size: 0.6rem;
    color: var(--rojo);
    background: rgba(255,68,68,0.1);
    border: 1px solid rgba(255,68,68,0.2);
    border-radius: 2px;
    padding: 2px 5px;
    font-family: 'Space Mono', monospace;
  }

  .btn-menu-card {
    background: none;
    border: none;
    color: #444;
    cursor: pointer;
    font-size: 0.9rem;
    letter-spacing: 2px;
    transition: color 0.2s;
  }

  .btn-menu-card:hover { color: #fff; }

  .card-nombre {}

  .card-marca {
    font-size: 0.65rem;
    color: #444;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  .card-modelo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 1.5px;
    color: #fff;
    line-height: 1;
  }

  .card-specs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid var(--borde);
    padding-top: 0.9rem;
  }

  .spec-fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .spec-key {
    font-size: 0.65rem;
    color: #444;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .spec-val {
    font-size: 0.75rem;
    color: #aaa;
    font-family: 'Space Mono', monospace;
  }

  .muestra-color {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.1);
  }

  .card-acciones { display: flex; gap: 0.5rem; }

  .btn-ver {
    flex: 1;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--borde);
    color: #aaa;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    padding: 0.35rem 0.8rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-ver:hover { background: rgba(255,255,255,0.08); color: #fff; }

  .btn-fav {
    background: rgba(255,68,68,0.08);
    border: 1px solid rgba(255,68,68,0.15);
    color: var(--rojo);
    font-size: 0.9rem;
    padding: 0.35rem 0.7rem;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.15s;
  }

  .btn-fav:hover { background: rgba(255,68,68,0.2); }

  .sin-resultados {
    color: #444;
    font-size: 0.85rem;
    text-align: center;
    padding: 3rem 0;
  }

  .oculto { display: none !important; }

  .overlay-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    backdrop-filter: blur(4px);
  }

  .modal {
    background: #111;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    width: 100%;
    max-width: 460px;
    overflow: hidden;
  }

  .modal-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid var(--borde);
  }

  .modal-titulo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 2px;
  }

  .modal-cerrar {
    background: none;
    border: none;
    color: #555;
    cursor: pointer;
    transition: color 0.2s;
  }

  .modal-cerrar:hover { color: #fff; }

  .modal-cuerpo {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .fila-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  .campo-form { display: flex; flex-direction: column; gap: 0.4rem; }

  .etiqueta-campo {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #666;
  }

  .input-form {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--borde);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }

  .input-form:focus { border-color: rgba(57,255,20,0.4); }
  .input-form::placeholder { color: #333; }
  .select-form { cursor: pointer; }
  .select-form option { background: #111; }
  .input-color { padding: 0.25rem; height: 38px; cursor: pointer; }

  .modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--borde);
    display: flex;
    justify-content: flex-end;
    gap: 0.7rem;
  }

  .btn-cancelar {
    background: none;
    border: 1px solid var(--borde);
    color: #666;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 1.5px;
    padding: 0.5rem 1.2rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-cancelar:hover { color: #fff; border-color: rgba(255,255,255,0.2); }

  .btn-guardar {
    background: var(--verde);
    border: none;
    color: #050505;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 1.5px;
    padding: 0.5rem 1.4rem;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .btn-guardar:hover { opacity: 0.85; }
</style>

<script>
  const btnAbrir = document.getElementById('btn-abrir-modal');
  const btnCerrar = document.getElementById('btn-cerrar-modal');
  const btnCancelar = document.getElementById('btn-cancelar');
  const overlay = document.getElementById('overlay-modal');

  btnAbrir?.addEventListener('click', () => overlay?.classList.remove('oculto'));
  btnCerrar?.addEventListener('click', () => overlay?.classList.add('oculto'));
  btnCancelar?.addEventListener('click', () => overlay?.classList.add('oculto'));
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.add('oculto'); });

  const chips = document.querySelectorAll('.chip[data-filtro]');
  const cards = document.querySelectorAll('.card-auto');
  const sinResultados = document.getElementById('sin-resultados');

  function filtrar() {
    const filtroActivo = document.querySelector('.chip.activo')?.getAttribute('data-filtro') || 'todos';
    const busqueda = (document.getElementById('buscador') as HTMLInputElement)?.value.toLowerCase() || '';
    let visibles = 0;
    cards.forEach(card => {
      const estilo = card.getAttribute('data-estilo') || '';
      const nombre = card.getAttribute('data-nombre') || '';
      const ok = (filtroActivo === 'todos' || estilo === filtroActivo) && nombre.includes(busqueda);
      (card as HTMLElement).style.display = ok ? '' : 'none';
      if (ok) visibles++;
    });
    sinResultados?.classList.toggle('oculto', visibles > 0);
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('activo'));
      chip.classList.add('activo');
      filtrar();
    });
  });

  document.getElementById('buscador')?.addEventListener('input', filtrar);
</script>