---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout titulo="Mi Perfil">
  <Navbar />
  <main class="con-nav">
    <section class="cabecera-pagina">
      <div class="contenedor">
        <div class="perfil-cabecera">
          <div class="avatar-wrapper">
            <div class="avatar">
              <span class="avatar-iniciales">MG</span>
            </div>
            <button class="btn-cambiar-foto">Cambiar foto</button>
          </div>
          <div class="info-usuario">
            <h1 class="nombre-usuario">Mateo García</h1>
            <p class="usuario-handle">@mateogarcia</p>
            <p class="usuario-desde">Miembro desde Abril 2025</p>
            <div class="stats-perfil">
              <div class="stat-mini">
                <span class="stat-mini-num verde">8</span>
                <span class="stat-mini-label">Autos</span>
              </div>
              <div class="stat-mini">
                <span class="stat-mini-num rojo">2</span>
                <span class="stat-mini-label">Favoritos</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="seccion-perfil">
      <div class="contenedor layout-perfil">
        <div class="columna-form">
          <div class="card-seccion">
            <h2 class="titulo-seccion-card">Información personal</h2>
            <div class="campos-perfil">
              <div class="fila-campos">
                <div class="campo-form">
                  <label class="etiqueta-campo">Nombre</label>
                  <input type="text" class="input-form" value="Mateo" />
                </div>
                <div class="campo-form">
                  <label class="etiqueta-campo">Apellido</label>
                  <input type="text" class="input-form" value="García" />
                </div>
              </div>
              <div class="campo-form">
                <label class="etiqueta-campo">Nombre de usuario</label>
                <div class="input-prefijo-wrapper">
                  <span class="input-prefijo">@</span>
                  <input type="text" class="input-form con-prefijo" value="mateogarcia" />
                </div>
              </div>
              <div class="campo-form">
                <label class="etiqueta-campo">Email</label>
                <input type="email" class="input-form" value="mateo@ejemplo.com" />
              </div>
              <div class="campo-form">
                <label class="etiqueta-campo">Bio</label>
                <textarea class="input-form textarea-form" placeholder="Contá algo sobre vos...">Fan de los JDM y los RPGs difíciles. Completé Elden Ring 3 veces.</textarea>
              </div>
              <button class="boton-guardar">Guardar cambios</button>
            </div>
          </div>

          <div class="card-seccion">
            <h2 class="titulo-seccion-card">Cambiar contraseña</h2>
            <div class="campos-perfil">
              <div class="campo-form">
                <label class="etiqueta-campo">Contraseña actual</label>
                <input type="password" class="input-form" placeholder="••••••••" />
              </div>
              <div class="fila-campos">
                <div class="campo-form">
                  <label class="etiqueta-campo">Nueva contraseña</label>
                  <input type="password" class="input-form" placeholder="••••••••" />
                </div>
                <div class="campo-form">
                  <label class="etiqueta-campo">Repetir nueva</label>
                  <input type="password" class="input-form" placeholder="••••••••" />
                </div>
              </div>
              <button class="boton-guardar">Actualizar contraseña</button>
            </div>
          </div>
        </div>

        <div class="columna-lateral">
          <div class="card-seccion">
            <h2 class="titulo-seccion-card">Preferencias</h2>
            <div class="lista-preferencias">
              <div class="preferencia-item">
                <div class="pref-info">
                  <p class="pref-nombre">Notificaciones</p>
                  <p class="pref-desc">Recibir emails de la app</p>
                </div>
                <button class="toggle-switch activo" data-estado="on" id="toggle-notif"></button>
              </div>
              <div class="preferencia-item">
                <div class="pref-info">
                  <p class="pref-nombre">Perfil público</p>
                  <p class="pref-desc">Otros pueden ver tu colección</p>
                </div>
                <button class="toggle-switch" data-estado="off" id="toggle-publico"></button>
              </div>
              <div class="preferencia-item">
                <div class="pref-info">
                  <p class="pref-nombre">Modo oscuro</p>
                  <p class="pref-desc">Siempre activado 🖤</p>
                </div>
                <button class="toggle-switch activo" data-estado="on" disabled></button>
              </div>
            </div>
          </div>

          <div class="card-seccion card-peligro">
            <h2 class="titulo-seccion-card rojo">Zona de peligro</h2>
            <p class="texto-peligro">Estas acciones no se pueden deshacer. Pensalo bien.</p>
            <div class="acciones-peligro">
              <button class="btn-peligro btn-limpiar">Limpiar colección</button>
              <button class="btn-peligro btn-eliminar">Eliminar cuenta</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cabecera-pagina {
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid var(--borde);
  }

  .perfil-cabecera {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .avatar-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(57,255,20,0.3), rgba(0,207,255,0.3));
    border: 2px solid rgba(57,255,20,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-iniciales {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem;
    color: #fff;
    letter-spacing: 2px;
  }

  .btn-cambiar-foto {
    background: none;
    border: none;
    color: var(--verde);
    font-size: 0.65rem;
    font-family: 'Space Mono', monospace;
    letter-spacing: 1px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .btn-cambiar-foto:hover { opacity: 1; }

  .info-usuario { flex: 1; }

  .nombre-usuario {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    letter-spacing: 1.5px;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .usuario-handle {
    font-size: 0.8rem;
    color: var(--verde);
    margin-bottom: 0.3rem;
    opacity: 0.8;
  }

  .usuario-desde {
    font-size: 0.7rem;
    color: #555;
    margin-bottom: 1rem;
  }

  .stats-perfil {
    display: flex;
    gap: 1.5rem;
  }

  .stat-mini {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-mini-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    color: #fff;
    letter-spacing: 1px;
    line-height: 1;
  }

  .stat-mini-num.verde { color: var(--verde); }
  .stat-mini-num.rojo { color: var(--rojo); }

  .stat-mini-label {
    font-size: 0.6rem;
    color: #444;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .seccion-perfil { padding: 2.5rem 0 5rem; }

  .layout-perfil {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    align-items: start;
  }

  .columna-form { display: flex; flex-direction: column; gap: 1.5rem; }
  .columna-lateral { display: flex; flex-direction: column; gap: 1.5rem; }

  .card-seccion {
    background: var(--fondo-card);
    border: 1px solid var(--borde);
    border-radius: 10px;
    padding: 1.5rem;
  }

  .titulo-seccion-card {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 2px;
    color: #fff;
    margin-bottom: 1.2rem;
  }

  .titulo-seccion-card.rojo { color: var(--rojo); }

  .campos-perfil { display: flex; flex-direction: column; gap: 1rem; }

  .fila-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  .campo-form { display: flex; flex-direction: column; gap: 0.4rem; }

  .etiqueta-campo {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #666;
  }

  .input-form {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--borde);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-radius: 6px;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }

  .input-form:focus { border-color: rgba(57,255,20,0.4); }
  .input-form::placeholder { color: #333; }

  .textarea-form {
    resize: vertical;
    min-height: 80px;
    line-height: 1.6;
  }

  .input-prefijo-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-prefijo {
    position: absolute;
    left: 0.9rem;
    color: #555;
    font-size: 0.85rem;
    pointer-events: none;
  }

  .con-prefijo { padding-left: 1.7rem; }

  .boton-guardar {
    background: var(--verde);
    border: none;
    color: #050505;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 2px;
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  .boton-guardar:hover { opacity: 0.85; }

  .lista-preferencias { display: flex; flex-direction: column; gap: 0; }

  .preferencia-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--borde);
    gap: 1rem;
  }

  .preferencia-item:last-child { border-bottom: none; }

  .pref-nombre {
    font-size: 0.82rem;
    color: #ccc;
    margin-bottom: 0.2rem;
  }

  .pref-desc { font-size: 0.65rem; color: #555; }

  .toggle-switch {
    width: 38px;
    height: 20px;
    border-radius: 10px;
    background: #222;
    border: 1px solid #333;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    transition: background 0.2s, border-color 0.2s;
  }

  .toggle-switch::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    background: #555;
    border-radius: 50%;
    top: 2px;
    left: 2px;
    transition: transform 0.2s, background 0.2s;
  }

  .toggle-switch.activo {
    background: rgba(57,255,20,0.2);
    border-color: rgba(57,255,20,0.4);
  }

  .toggle-switch.activo::after {
    transform: translateX(18px);
    background: var(--verde);
  }

  .toggle-switch:disabled { opacity: 0.5; cursor: not-allowed; }

  .card-peligro { border-color: rgba(255,68,68,0.2); }

  .texto-peligro { font-size: 0.75rem; color: #666; margin-bottom: 1rem; line-height: 1.6; }

  .acciones-peligro { display: flex; flex-direction: column; gap: 0.5rem; }

  .btn-peligro {
    background: none;
    border: 1px solid rgba(255,68,68,0.25);
    color: var(--rojo);
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 1.5px;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
  }

  .btn-peligro:hover {
    background: rgba(255,68,68,0.1);
    border-color: rgba(255,68,68,0.4);
  }

  .btn-eliminar { color: #ff2222; border-color: rgba(255,34,34,0.3); }

  @media (max-width: 900px) {
    .layout-perfil { grid-template-columns: 1fr; }
  }

  @media (max-width: 500px) {
    .fila-campos { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll('.toggle-switch:not([disabled])').forEach(toggle => {
    toggle.addEventListener('click', () => {
      toggle.classList.toggle('activo');
    });
  });
</script>