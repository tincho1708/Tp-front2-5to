---
---

<nav class="barra-nav">
  <div class="contenedor-nav">
    <a href="/" class="logo-marca">
      <span class="logo-icono">⚡</span>
      <span class="logo-texto">GRID<span class="logo-acento">VAULT</span></span>
    </a>

    <ul class="menu-links">
      <li><a href="/" class="link-nav">Inicio</a></li>
      <li><a href="/autos" class="link-nav">Autos</a></li>
      <li><a href="/coleccion" class="link-nav">Mi Colección</a></li>
    </ul>

    <div class="acciones-nav">
      <a href="/login" class="boton-entrar">Entrar</a>
      <button class="boton-menu-movil" id="btn-hamburguesa" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu-movil" id="menu-movil">
    <ul class="links-movil">
      <li><a href="/">Inicio</a></li>
      <li><a href="/autos">Autos</a></li>
      <li><a href="/coleccion">Mi Colección</a></li>
      <li><a href="/login">Entrar</a></li>
    </ul>
  </div>
</nav>

<style>
  .barra-nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 999;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(57, 255, 20, 0.15);
  }

  .contenedor-nav {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo-marca {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem;
    letter-spacing: 2px;
    color: #fff;
  }

  .logo-icono { font-size: 1.4rem; }
  .logo-acento { color: #39ff14; }

  .menu-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link-nav {
    text-decoration: none;
    color: #aaa;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 1.5px;
    transition: color 0.2s;
    position: relative;
  }

  .link-nav::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #39ff14;
    transition: width 0.25s;
  }

  .link-nav:hover { color: #39ff14; }
  .link-nav:hover::after { width: 100%; }

  .acciones-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .boton-entrar {
    text-decoration: none;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 2px;
    color: #050505;
    background: #39ff14;
    padding: 0.4rem 1.2rem;
    border-radius: 3px;
    transition: box-shadow 0.2s, transform 0.15s;
  }

  .boton-entrar:hover {
    box-shadow: 0 0 18px #39ff14aa;
    transform: translateY(-1px);
  }

  .boton-menu-movil {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .boton-menu-movil span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    transition: all 0.3s;
  }

  .menu-movil {
    display: none;
    padding: 1rem 1.5rem;
    border-top: 1px solid rgba(57, 255, 20, 0.1);
  }

  .links-movil {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .links-movil a {
    text-decoration: none;
    color: #aaa;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 2px;
  }

  .links-movil a:hover { color: #39ff14; }
  .menu-movil.abierto { display: block; }

  @media (max-width: 768px) {
    .menu-links { display: none; }
    .boton-entrar { display: none; }
    .boton-menu-movil { display: flex; }
  }
</style>

<script>
  const btnHamburguesa = document.getElementById('btn-hamburguesa');
  const menuMovil = document.getElementById('menu-movil');
  btnHamburguesa?.addEventListener('click', () => {
    menuMovil?.classList.toggle('abierto');
  });
</script>