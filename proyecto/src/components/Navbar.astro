---
---

<nav class="barra-nav">
  <div class="contenedor-nav">
    <a href="/" class="logo-marca">
      <span class="logo-icono">⚡</span>
      <span class="logo-texto">GRID<span class="logo-acento">VAULT</span></span>
    </a>

    <ul class="menu-links">
      <li><a href="/" class="link-nav">Inicio</a></li>
      <li><a href="/autos" class="link-nav">Autos</a></li>
      <li><a href="/coleccion" class="link-nav">Mi Colección</a></li>
    </ul>

    <div class="acciones-nav">
      <!-- Estado sin sesión -->
      <a href="/login" class="boton-entrar" id="btn-entrar">Entrar</a>

      <!-- Estado con sesión (oculto por default, se muestra con JS) -->
      <div class="usuario-menu oculto" id="usuario-menu">
        <a href="/perfil" class="usuario-chip" id="chip-usuario">
          <span class="avatar-nav" id="avatar-nav">?</span>
          <span id="nombre-nav">Perfil</span>
        </a>
        <button class="btn-logout" id="btn-logout" title="Cerrar sesión">⏻</button>
      </div>

      <button class="boton-menu-movil" id="btn-hamburguesa" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu-movil" id="menu-movil">
    <ul class="links-movil">
      <li><a href="/">Inicio</a></li>
      <li><a href="/autos">Autos</a></li>
      <li><a href="/coleccion">Mi Colección</a></li>
      <li id="movil-auth-link"><a href="/login">Entrar</a></li>
    </ul>
  </div>
</nav>

<style>
  .barra-nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 999;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(57, 255, 20, 0.15);
  }

  .contenedor-nav {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo-marca {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem;
    letter-spacing: 2px;
    color: #fff;
  }

  .logo-icono { font-size: 1.4rem; }
  .logo-acento { color: #39ff14; }

  .menu-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link-nav {
    text-decoration: none;
    color: #aaa;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 1.5px;
    transition: color 0.2s;
    position: relative;
  }

  .link-nav::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #39ff14;
    transition: width 0.25s;
  }

  .link-nav:hover { color: #39ff14; }
  .link-nav:hover::after { width: 100%; }

  .acciones-nav { display: flex; align-items: center; gap: 1rem; }

  .boton-entrar {
    text-decoration: none;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 2px;
    color: #050505;
    background: #39ff14;
    padding: 0.4rem 1.2rem;
    border-radius: 3px;
    transition: box-shadow 0.2s, transform 0.15s;
  }

  .boton-entrar:hover { box-shadow: 0 0 18px #39ff14aa; transform: translateY(-1px); }

  .usuario-menu {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .usuario-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    background: rgba(57,255,20,0.08);
    border: 1px solid rgba(57,255,20,0.2);
    border-radius: 20px;
    padding: 0.3rem 0.8rem 0.3rem 0.4rem;
    transition: background 0.2s;
  }

  .usuario-chip:hover { background: rgba(57,255,20,0.15); }

  .avatar-nav {
    width: 26px;
    height: 26px;
    background: rgba(57,255,20,0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.8rem;
    color: #fff;
    flex-shrink: 0;
  }

  #nombre-nav {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 1px;
    color: var(--verde);
  }

  .btn-logout {
    background: rgba(255,68,68,0.08);
    border: 1px solid rgba(255,68,68,0.2);
    color: var(--rojo);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .btn-logout:hover { background: rgba(255,68,68,0.2); }

  .boton-menu-movil {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .boton-menu-movil span { display: block; width: 24px; height: 2px; background: #fff; transition: all 0.3s; }

  .menu-movil {
    display: none;
    padding: 1rem 1.5rem;
    border-top: 1px solid rgba(57, 255, 20, 0.1);
  }

  .links-movil {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .links-movil a {
    text-decoration: none;
    color: #aaa;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 2px;
  }

  .links-movil a:hover { color: #39ff14; }
  .menu-movil.abierto { display: block; }

  .oculto { display: none !important; }

  @media (max-width: 768px) {
    .menu-links { display: none; }
    .boton-entrar { display: none; }
    .usuario-menu { display: none !important; }
    .boton-menu-movil { display: flex; }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const btnEntrar = document.getElementById('btn-entrar')!;
  const usuarioMenu = document.getElementById('usuario-menu')!;
  const avatarNav = document.getElementById('avatar-nav')!;
  const nombreNav = document.getElementById('nombre-nav')!;
  const btnLogout = document.getElementById('btn-logout')!;
  const movilAuthLink = document.getElementById('movil-auth-link')!;

  async function actualizarNavbar() {
    const { data: { user } } = await supabase.auth.getUser();

    if (user) {
      btnEntrar.classList.add('oculto');
      usuarioMenu.classList.remove('oculto');

      const meta = user.user_metadata || {};
      const nombre = meta.nombre || meta.usuario || user.email!.split('@')[0];
      nombreNav.textContent = nombre.split(' ')[0];
      avatarNav.textContent = nombre.slice(0, 2).toUpperCase();

      movilAuthLink.innerHTML = '<button id="btn-logout-movil" style="background:none;border:none;color:#ff4444;font-family:\'Bebas Neue\',sans-serif;font-size:1.1rem;letter-spacing:2px;cursor:pointer;padding:0;">Cerrar sesión</button>';
      document.getElementById('btn-logout-movil')?.addEventListener('click', logout);
    }
  }

  async function logout() {
    await supabase.auth.signOut();
    window.location.href = '/';
  }

  btnLogout.addEventListener('click', logout);

  const btnHamburguesa = document.getElementById('btn-hamburguesa');
  const menuMovil = document.getElementById('menu-movil');
  btnHamburguesa?.addEventListener('click', () => menuMovil?.classList.toggle('abierto'));

  actualizarNavbar();
</script>
