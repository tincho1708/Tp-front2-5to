---
interface Props {
  marca: string;
  modelo: string;
  anio: number;
  estilo: string;
  potencia?: string;
  color: string;
  favorito?: boolean;
}

const { marca, modelo, anio, estilo, potencia, color, favorito = false } = Astro.props;
---

<article class="tarjeta-auto">
  <div class="barra-color" style={`background: ${color}`}></div>

  <div class="contenido-auto">
    <div class="cabecera-auto">
      <div class="info-estilo">
        <span class="badge-estilo">{estilo}</span>
        {favorito && <span class="badge-favorito">❤ FAV</span>}
      </div>
      <button class="boton-mas">···</button>
    </div>

    <div class="nombre-auto">
      <p class="marca-auto">{marca}</p>
      <h3 class="modelo-auto">{modelo}</h3>
    </div>

    <div class="specs-auto">
      <div class="spec-fila">
        <span class="spec-etiqueta">Año</span>
        <span class="spec-valor">{anio}</span>
      </div>
      {potencia && (
        <div class="spec-fila">
          <span class="spec-etiqueta">Motor</span>
          <span class="spec-valor">{potencia}</span>
        </div>
      )}
      <div class="spec-fila">
        <span class="spec-etiqueta">Color</span>
        <span class="muestra-color" style={`background: ${color}`}></span>
      </div>
    </div>

    <div class="acciones-auto">
      <button class="btn-ver-auto">Ver detalle</button>
      <button class="btn-fav-auto">{favorito ? '❤' : '♡'}</button>
    </div>
  </div>
</article>

<style>
  .tarjeta-auto {
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    position: relative;
  }

  .tarjeta-auto:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    border-color: rgba(255,255,255,0.15);
  }

  .barra-color {
    height: 4px;
    width: 100%;
  }

  .contenido-auto {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cabecera-auto {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .info-estilo {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .badge-estilo {
    font-size: 0.6rem;
    font-family: 'Space Mono', monospace;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #aaa;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    padding: 2px 7px;
  }

  .badge-favorito {
    font-size: 0.6rem;
    font-family: 'Space Mono', monospace;
    letter-spacing: 1px;
    color: #ff4444;
    background: rgba(255, 68, 68, 0.1);
    border: 1px solid rgba(255,68,68,0.2);
    border-radius: 2px;
    padding: 2px 6px;
  }

  .boton-mas {
    background: none;
    border: none;
    color: #555;
    cursor: pointer;
    font-size: 1rem;
    letter-spacing: 2px;
    transition: color 0.2s;
    padding: 0;
  }

  .boton-mas:hover {
    color: #fff;
  }

  .nombre-auto {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .marca-auto {
    font-size: 0.7rem;
    color: #555;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: 'Space Mono', monospace;
    margin: 0;
  }

  .modelo-auto {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem;
    color: #fff;
    letter-spacing: 2px;
    margin: 0;
    line-height: 1;
  }

  .specs-auto {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-top: 1rem;
  }

  .spec-fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .spec-etiqueta {
    font-size: 0.7rem;
    color: #444;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: 'Space Mono', monospace;
  }

  .spec-valor {
    font-size: 0.8rem;
    color: #ccc;
    font-family: 'Space Mono', monospace;
  }

  .muestra-color {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.1);
  }

  .acciones-auto {
    display: flex;
    gap: 0.5rem;
  }

  .btn-ver-auto {
    flex: 1;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: #ccc;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 1.5px;
    padding: 0.4rem 0.8rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-ver-auto:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
  }

  .btn-fav-auto {
    background: rgba(255, 68, 68, 0.08);
    border: 1px solid rgba(255, 68, 68, 0.15);
    color: #ff4444;
    font-size: 1rem;
    padding: 0.4rem 0.7rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-fav-auto:hover {
    background: rgba(255, 68, 68, 0.2);
  }
</style>